# AI Engagement Center — environment template. Copy to .env.local. Never commit real secrets.
# SQLite database file (created by `npm run seed`)
AEC_DB_PATH=./data/aec.db
# Seed size (customers / events). Defaults: 10000 / 100000
AEC_SEED_CUSTOMERS=10000
AEC_SEED_EVENTS=100000
AEC_SEED=42
# Session signing secret (any long random string)
AEC_SESSION_SECRET=change-me-to-a-long-random-string
# AI provider: mock | anthropic | openai | openai_compatible   (mock is default; no network calls)
AEC_AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenAI-compatible endpoint (DeepSeek, Ollama http://localhost:11434/v1, Gemini OpenAI-compat, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
# Webhook signing secret for inbound delivery events (HMAC-SHA256)
AEC_WEBHOOK_SECRET=dev-webhook-secret
# All external messaging providers stay disabled until explicitly configured + verified.
AEC_ALLOW_REAL_SENDING=false
